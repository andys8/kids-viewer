<?xml version="1.0" encoding="utf-8"?><!--
    A photo card (sun over hills) with a play badge: says "photos and videos" at a glance.
    All artwork stays inside the adaptive-icon safe zone (a 66dp circle centred in the 108dp
    viewport) so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Photo card -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,30 L70,30 A6,6 0 0 1 76,36 L76,64 A6,6 0 0 1 70,70 L30,70 A6,6 0 0 1 24,64 L24,36 A6,6 0 0 1 30,30 Z" />

    <!-- Sun -->
    <path
        android:fillColor="#FFC24B"
        android:pathData="M37,43 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />

    <!-- Hills -->
    <path
        android:fillColor="#FF7A45"
        android:pathData="M27,66 L43,49 L54,60 L63,51 L74,66 Z" />

    <!-- Play badge -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M71,67 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0" />
    <path
        android:fillColor="#FF7A45"
        android:pathData="M67,61 L67,73 L77,67 Z" />
</vector>
