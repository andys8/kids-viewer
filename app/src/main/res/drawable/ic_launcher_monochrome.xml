<?xml version="1.0" encoding="utf-8"?><!--
    Silhouette used by themed icons on Android 13+. The system tints it a single colour, so the
    lens ring is knocked out of the body (evenOdd) with the glass drawn back in, which keeps the
    camera readable without any of the colour the normal icon relies on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Viewfinder bump: stops exactly at the body edge so it never overlaps it -->
    <path
        android:fillColor="#000000"
        android:pathData="M48.5,31.5 L59.5,31.5 A4.5,4.5 0 0 1 64,36 L64,41.8 L44,41.8 L44,36 A4.5,4.5 0 0 1 48.5,31.5 Z" />

    <!-- Body with the lens ring knocked out -->
    <path
        android:fillColor="#000000"
        android:fillType="evenOdd"
        android:pathData="M35,41.5 L73,41.5 A10,10 0 0 1 83,51.5 L83,66.5 A10,10 0 0 1 73,76.5 L35,76.5 A10,10 0 0 1 25,66.5 L25,51.5 A10,10 0 0 1 35,41.5 Z M54,59 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0" />

    <!-- Lens glass -->
    <path
        android:fillColor="#000000"
        android:pathData="M54,59 m-8.5,0 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0" />
</vector>
